-a never,exit -F path=/home/devise/insights/production/rav_twente/insights.RDS
-a never,exit -F path=/home/devise/insights/production/rav_utrecht/insights.RDS
-a never,exit -F path=/home/devise/insights/production/roaz_aznn/insights.RDS
-a never,exit -F path=/home/devise/insights/test/hap_hcdo/insights.RDS
-a never,exit -F path=/home/devise/insights/test/mk_limburg/insights.RDS
-a never,exit -F path=/home/devise/insights/test/mknn/insights.RDS
-a never,exit -F path=/home/devise/insights/test/mmt_ams/insights.RDS
-a never,exit -F path=/home/devise/insights/test/mmt_gr/insights.RDS
