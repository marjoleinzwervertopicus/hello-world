-a never,exit -F path=/home/devise/insights/test/roaz_aznn/insights.RDS

# users.RDS: cache die de app opnieuw opbouwt uit de gemonitorde
# gebruikersbestanden in configs/<env>/<klant>/users/. Eén regel per klant.
-a never,exit -F path=/home/devise/configs/production/hap_hcdo/users/users.RDS
-a never,exit -F path=/home/devise/configs/production/kwaliteitskaderapp/users/users.RDS
