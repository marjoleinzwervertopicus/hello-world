## =====================================================================
## Baseline 2.2.1 - Logging van het gebruik van beheerfunctionaliteiten
## =====================================================================
## Regelset voor de beast-server (Ubuntu 24.04).

## ---------------------------------------------------------------------
## Instellingen
## ---------------------------------------------------------------------
# Verwijder bestaande regels
-D

# Buffer groot genoeg om geen events te verliezen
-b 8192

# Possible values: 0 (silent), 1 (printk, print a failure message), 2 (panic, halt the system)
-f 1

# Ignore errors
## Keep optional distro-specific paths from aborting the whole load.
## For strict validation, test a copy of this file with this line removed.
-i

## ---------------------------------------------------------------------
## Uitsluitingen
## ---------------------------------------------------------------------
# Sleutelbeheer-records die SSH bij elke verbinding aanmaakt; de login zelf wordt apart gelogd (USER_LOGIN/USER_START)
-a always,exclude -F msgtype=CRYPTO_KEY_USER

# insights.RDS: cache die de app opnieuw opbouwt uit de gemonitorde
# bronbestanden in dezelfde map (Platform/utilities/insight_config.R).
# auditd kent geen wildcards: één regel per <env>/<klant>. Bij een nieuwe
# klant/omgeving hier aanvullen. Development (dynamische paden) is niet uitgesloten.
-a never,exit -F path=/home/devise/insights/production/hap_hcdo/insights.RDS
-a never,exit -F path=/home/devise/insights/production/mk_limburg/insights.RDS
-a never,exit -F path=/home/devise/insights/production/mknn/insights.RDS
-a never,exit -F path=/home/devise/insights/production/mmt_ams/insights.RDS
-a never,exit -F path=/home/devise/insights/production/mmt_gr/insights.RDS
-a never,exit -F path=/home/devise/insights/production/rav_brabant_midden_west_noord/insights.RDS
-a never,exit -F path=/home/devise/insights/production/rav_brabant_zuidoost/insights.RDS
-a never,exit -F path=/home/devise/insights/production/rav_drenthe/insights.RDS
-a never,exit -F path=/home/devise/insights/production/rav_fryslan/insights.RDS
-a never,exit -F path=/home/devise/insights/production/rav_gelderland_zuid/insights.RDS
-a never,exit -F path=/home/devise/insights/production/rav_groningen/insights.RDS
