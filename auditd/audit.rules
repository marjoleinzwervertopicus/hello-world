-a never,exit -F path=/home/devise/configs/test/rav_brabant_zuidoost/users/users.RDS
-a never,exit -F path=/home/devise/configs/test/rav_drenthe/users/users.RDS
-a never,exit -F path=/home/devise/configs/test/rav_fryslan/users/users.RDS
-a never,exit -F path=/home/devise/configs/test/rav_gelderland_zuid/users/users.RDS
-a never,exit -F path=/home/devise/configs/test/rav_groningen/users/users.RDS
-a never,exit -F path=/home/devise/configs/test/rav_hollands_midden/users/users.RDS
-a never,exit -F path=/home/devise/configs/test/rav_ijsselland/users/users.RDS
-a never,exit -F path=/home/devise/configs/test/rav_kennemerland/users/users.RDS
-a never,exit -F path=/home/devise/configs/test/rav_limburg/users/users.RDS
-a never,exit -F path=/home/devise/configs/test/rav_twente/users/users.RDS
-a never,exit -F path=/home/devise/configs/test/rav_utrecht/users/users.RDS
-a never,exit -F path=/home/devise/configs/test/roaz_aznn/users/users.RDS
-a never,exit -F path=/home/devise/configs/test/upload/users/users.RDS

## ---------------------------------------------------------------------
## Bescherming van de logging zelf
## ---------------------------------------------------------------------
# Wijzigen van auditd-configuratie en -regels (o.a. uitschakelen van logging)
-w /etc/audit/ -p wa -k auditconfig
-w /etc/libaudit.conf -p wa -k auditconfig
# Uitvoeren van auditctl (regels tijdelijk aanpassen of uitzetten zonder bestandswijziging)
-a always,exit -F path=/usr/sbin/auditctl -F perm=x -k auditconfig
# Aanpassen/verwijderen van de auditlogs (log_file staat op het block volume)
-w /mnt/volume_block_1/auditd_logs/ -p wa -k auditlog
-w /var/log/audit/ -p wa -k auditlog

## ---------------------------------------------------------------------
## Aanmaken van gebruikers en het aanpassen van rechten
## ---------------------------------------------------------------------
# Lokale gebruikers en groepen (useradd/usermod/passwd/groupadd, ook lidmaatschap van sudo- en docker-groep)
-w /etc/passwd -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/subuid -p wa -k identity
-w /etc/subgid -p wa -k identity
# Beheerrechten via sudo
-w /etc/sudoers -p wa -k privileges
-w /etc/sudoers.d/ -p wa -k privileges
# Rechten via polkit (o.a. wie services mag beheren zonder sudo)
-w /etc/polkit-1/ -p wa -k privileges
# Authenticatie en toegangsregels (PAM, limits, access.conf, login-instellingen)
-w /etc/pam.d/ -p wa -k auth_config
-w /etc/security/ -p wa -k auth_config
-w /etc/login.defs -p wa -k auth_config
# Koppeling met centrale accounts (domeinaccounts zoals marjolein@devise.nl)
-w /etc/nsswitch.conf -p wa -k auth_config
-w /etc/sssd/ -p wa -k auth_config
-w /etc/krb5.conf -p wa -k auth_config
-w /etc/krb5.conf.d/ -p wa -k auth_config
# SSH-sleutels van root (toegang verlenen zonder wachtwoord)
-w /root/.ssh/ -p wa -k rootkey
# Bestandsrechten/eigenaar wijzigen met root-rechten door een ingelogde gebruiker (sudo chmod/chown).
# Alleen euid=0: gebruikers die hun eigen bestanden aanpassen is geen beheer.
-a always,exit -F arch=b64 -S chmod,fchmod,fchmodat,chown,fchown,fchownat,lchown -F euid=0 -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b32 -S chmod,fchmod,fchmodat,chown,fchown,fchownat,lchown,chown32,fchown32,lchown32 -F euid=0 -F auid>=1000 -F auid!=unset -k perm_mod

## ---------------------------------------------------------------------
## Applicatielaag: gebruikers, rechten en configuratie van de Devise-apps
## ---------------------------------------------------------------------
# user_groups.yml, users/, devise_users en application.yml per klant.
# Geen auid-filter: de apps (containers, auid=unset) schrijven hier bij gebruikersbeheer,
# en dat zijn juist de wijzigingen die vastgelegd moeten worden.
-w /home/devise/configs/ -p wa -k app_config
# Insight-configuratie per klant (bronbestanden; de cache insights.RDS is hierboven uitgesloten)
-w /home/devise/insights/ -p wa -k app_insights

## ---------------------------------------------------------------------
## Het aanpassen van de configuratie
## ---------------------------------------------------------------------
# SSH-server (toegang tot de server)
-w /etc/ssh/ -p wa -k sshd
# Kernelparameters
-w /etc/sysctl.conf -p wa -k sysctl
-w /etc/sysctl.d/ -p wa -k sysctl
# Netwerk en naamresolutie
-w /etc/netplan/ -p wa -k network
-w /etc/network/ -p wa -k network
-w /etc/hosts -p wa -k network
-w /etc/hostname -p wa -k network
-w /etc/resolv.conf -p wa -k network
-a always,exit -F arch=b64 -S sethostname,setdomainname -k network
-a always,exit -F arch=b32 -S sethostname,setdomainname -k network
# Cloud-init (DigitalOcean voert dit uit bij het opstarten; kan gebruikers/SSH-sleutels/scripts toevoegen)
-w /etc/cloud/ -p wa -k cloud_init
# Host-firewall
-w /etc/ufw/ -p wa -k firewall
-w /etc/iptables/ -p wa -k firewall
-w /etc/nftables.conf -p wa -k firewall
# Beveiligingsprofielen
-w /etc/apparmor/ -p wa -k mac_policy
-w /etc/apparmor.d/ -p wa -k mac_policy
# Standaardinstellingen van services en bootloader (o.a. /etc/default/grub)
-w /etc/default/ -p wa -k svc_defaults
# Koppelen van schijven (o.a. het volume met de auditlogs)
-w /etc/fstab -p wa -k fstab
# Library-paden en preloads (systeembreed gedrag van programma's)
-w /etc/ld.so.conf -p wa -k libpath
-w /etc/ld.so.conf.d/ -p wa -k libpath
-w /etc/ld.so.preload -p wa -k libpath
# Systeembrede omgevingsvariabelen en shell-instellingen
-w /etc/environment -p wa -k environment
-w /etc/profile -p wa -k environment
-w /etc/profile.d/ -p wa -k environment
-w /etc/bash.bashrc -p wa -k environment
# Systeemtijd en tijdzone (randvoorwaarde voor 2.2.3: klokken gesynchroniseerd)
# Alleen door ingelogde gebruikers; de NTP-dienst past de klok continu aan en wordt niet gelogd.
-a always,exit -F arch=b64 -S settimeofday,clock_settime -F auid>=1000 -F auid!=unset -k time
-a always,exit -F arch=b32 -S settimeofday,clock_settime -F auid>=1000 -F auid!=unset -k time
-w /etc/localtime -p wa -k time
-w /etc/chrony/ -p wa -k time
# Docker-daemon (o.a. registries, logging, netwerken)
-w /etc/docker/ -p wa -k docker_cfg
# Apparaatregels
-w /etc/udev/rules.d/ -p wa -k udev

## ---------------------------------------------------------------------
## Installeren van nieuwe functionaliteiten
## ---------------------------------------------------------------------
# Package managers gestart door een ingelogde gebruiker
-a always,exit -F path=/usr/bin/apt -F perm=x -F auid>=1000 -F auid!=unset -k install
-a always,exit -F path=/usr/bin/apt-get -F perm=x -F auid>=1000 -F auid!=unset -k install
-a always,exit -F path=/usr/bin/snap -F perm=x -F auid>=1000 -F auid!=unset -k install
-a always,exit -F path=/usr/bin/pip3 -F perm=x -F auid>=1000 -F auid!=unset -k install
# dpkg voert de installatie uit; zonder auid-filter zodat ook unattended-upgrades wordt gelogd
-a always,exit -F path=/usr/bin/dpkg -F perm=x -k install_pkg
# Toevoegen van package-bronnen en signing keys (repositories)
-w /etc/apt/ -p wa -k install_repo
# Software geïnstalleerd buiten de package manager om
-w /usr/local/ -p wa -k install_manual
-w /opt/ -p wa -k install_manual
# Kernelmodules laden/verwijderen (ongeacht welk programma ze laadt)
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k modules
-a always,exit -F arch=b32 -S init_module,finit_module,delete_module -k modules
-w /etc/modprobe.d/ -p wa -k modules
-w /etc/modules-load.d/ -p wa -k modules

## ---------------------------------------------------------------------
## Het activeren/deactiveren van services
## ---------------------------------------------------------------------
# Wie start/stop/enable/disable/mask uitvoert; reboot/shutdown/poweroff/halt zijn symlinks naar systemctl
-a always,exit -F path=/usr/bin/systemctl -F perm=x -F auid>=1000 -F auid!=unset -k service_ctl
-a always,exit -F path=/usr/sbin/service -F perm=x -F auid>=1000 -F auid!=unset -k service_ctl
# Unit-bestanden en enable/disable-symlinks (ook timers, die geplande taken starten).
# Units in /usr/local/lib/systemd vallen onder de /usr/local-watch bij Installeren (key install_manual).
-w /etc/systemd/ -p wa -k systemd
-w /usr/lib/systemd/ -p wa -k systemd
# Oude init-scripts
-w /etc/init.d/ -p wa -k init
-w /etc/rc.local -p wa -k init
# Geplande taken (cron/at) die processen op de achtergrond starten
-w /etc/crontab -p wa -k cron
-w /etc/cron.d/ -p wa -k cron
-w /etc/cron.daily/ -p wa -k cron
-w /etc/cron.hourly/ -p wa -k cron
-w /etc/cron.weekly/ -p wa -k cron
-w /etc/cron.monthly/ -p wa -k cron
-w /etc/cron.allow -p wa -k cron
-w /etc/cron.deny -p wa -k cron
-w /etc/at.allow -p wa -k cron
-w /etc/at.deny -p wa -k cron
-w /var/spool/cron/ -p wa -k cron
# Docker-commando's door ingelogde gebruikers (containers starten/stoppen, docker compose)
-a always,exit -F path=/usr/bin/docker -F perm=x -F auid>=1000 -F auid!=unset -k docker_ctl

## ---------------------------------------------------------------------
## Rebooten van het systeem
## ---------------------------------------------------------------------
# WIE rebootte: de service_ctl-regel hierboven (systemctl reboot/shutdown).
# DAT er gereboot is: systemd stuurt zelf SYSTEM_SHUTDOWN/SYSTEM_BOOT naar auditd, zonder regel.
# De reboot-syscall zelf (wordt aan het eind van de shutdown aangeroepen)
-a always,exit -F arch=b64 -S reboot -k reboot
-a always,exit -F arch=b32 -S reboot -k reboot
# Direct een andere kernel starten zonder volledige reboot (kexec)
-a always,exit -F arch=b64 -S kexec_load,kexec_file_load -k reboot

## ---------------------------------------------------------------------
## Optioneel: regels onveranderbaar maken
## ---------------------------------------------------------------------
# Met -e 2 kunnen regels pas na een reboot worden aangepast.
# Pas inschakelen als de regelset definitief is.
#-e 2
